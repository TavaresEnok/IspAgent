# ISPAgent — variáveis de ambiente (prefixo ISPAGENT_ conforme seção 2 do prompt de execução)
# Copie para .env e ajuste. Nada aqui é obrigatório para rodar em modo DEMO: toda credencial ausente
# faz o respectivo adapter cair em modo DEMO/Mock, nunca falha o boot.
#
# Os valores marcados "change_me" são EXEMPLOS: servem só para desenvolvimento local. A API avisa no log
# quando os encontra e, com ISPAGENT_ENV=production, RECUSA subir. Gere segredos reais com:
#   openssl rand -base64 48

# ---- Ambiente ----
# development | production. Em production: segredos fortes obrigatórios, CORS explícito, Web Chat público e
# rotas DEMO desligados por padrão, e o telefone digitado no Web Chat não identifica ninguém.
ISPAGENT_ENV=development

# ---- Portas / rede ----
ISPAGENT_WEB_PORT=3000
ISPAGENT_API_PORT=3001
ISPAGENT_DB_PORT=5433
ISPAGENT_REDIS_PORT=6380
# Onde API e web publicam suas portas no host. Banco e Redis são sempre 127.0.0.1.
# Atrás de um proxy reverso com TLS, deixe 127.0.0.1; use 0.0.0.0 só se souber o que está fazendo.
ISPAGENT_BIND_ADDR=127.0.0.1
# Origens (separadas por vírgula) que o navegador pode usar para chamar a API. Em desenvolvimento
# localhost já é liberado; em produção é obrigatório. Ex.: https://painel.seuprovedor.com.br
ISPAGENT_CORS_ORIGINS=
# Quantos proxies há na frente da API (ex.: 1). Sem isso, o rate limit enxerga o IP do proxy.
ISPAGENT_TRUST_PROXY=

# ---- Banco de dados ----
ISPAGENT_DB_HOST=ispagent-db
ISPAGENT_DB_PORT_INTERNAL=5432
ISPAGENT_DB_USER=ispagent
ISPAGENT_DB_PASSWORD=ispagent_dev_password
ISPAGENT_DB_NAME=ispagent
# String usada por ferramentas rodando NO HOST (migrate/seed): porta publicada (5433), não o hostname
# interno do container. Dentro dos containers, o docker-compose.yml sobrescreve esta variável para
# apontar para ispagent-db:5432 (rede interna do compose). Os testes NUNCA usam este banco: derivam
# `<nome>_test` automaticamente (apps/api/test/test-db.js).
ISPAGENT_DATABASE_URL=postgresql://ispagent:ispagent_dev_password@localhost:5433/ispagent?schema=public

# ---- Redis / filas ----
ISPAGENT_REDIS_PASSWORD=ispagent_dev_redis
ISPAGENT_REDIS_URL=redis://:ispagent_dev_redis@localhost:6380

# ---- Auth / segredos ----
# Os dois segredos JWT precisam ser diferentes entre si, fortes e (em produção) ≥ 32 caracteres.
ISPAGENT_JWT_SECRET=change_me_dev_only_jwt_secret
ISPAGENT_JWT_REFRESH_SECRET=change_me_dev_only_refresh_secret
ISPAGENT_JWT_ACCESS_TTL=15m
ISPAGENT_JWT_REFRESH_TTL=7d
# Chave que cifra (AES-256-GCM) as credenciais de terceiros guardadas no banco: chaves de IA e senha do
# PulseISP. Obrigatória em produção. PERDER ou TROCAR esta chave torna essas credenciais ilegíveis
# (é preciso digitá-las de novo no painel) — guarde-a em local seguro. Em dev, sem ela, deriva do JWT.
ISPAGENT_ENCRYPTION_KEY=

# ---- Web Chat público / rotas DEMO ----
# Padrão: ligados fora de produção, desligados em produção. Defina true/false só para forçar.
ISPAGENT_WEBCHAT_PUBLIC_ENABLED=
ISPAGENT_DEMO_ENDPOINTS=

# ---- Chamadas de saída (proteção contra SSRF) ----
# Em produção a URL do PulseISP precisa ser https e não pode apontar para rede interna, exceto hosts
# listados aqui (separados por vírgula). Ex.: pulse.interno.local
ISPAGENT_OUTBOUND_ALLOWED_HOSTS=

# ---- AI Provider ----
# Configurado pela tela "IA" do painel de staff (fica no banco, cifrado, por tenant), não por env var — as
# linhas abaixo não são lidas em runtime, ficam só como referência histórica.
ISPAGENT_AI_PROVIDER=anthropic
ISPAGENT_ANTHROPIC_API_KEY=
ISPAGENT_ANTHROPIC_MODEL=claude-sonnet-5
ISPAGENT_GEMINI_API_KEY=
ISPAGENT_GEMINI_MODEL=gemini-2.0-flash
ISPAGENT_OPENAI_API_KEY=

# ---- ERP ----
# demo | ixc | sgp — sem credenciais válidas, o adapter real cai para NOT_SUPPORTED/DEMO conforme adapter.
ISPAGENT_ERP_PROVIDER=demo
ISPAGENT_IXC_BASE_URL=
ISPAGENT_IXC_TOKEN=
ISPAGENT_SGP_BASE_URL=
ISPAGENT_SGP_TOKEN=
ISPAGENT_SGP_APP=

# ---- PulseISP (opcional) ----
ISPAGENT_PULSEISP_ENABLED=false
ISPAGENT_PULSEISP_BASE_URL=
ISPAGENT_PULSEISP_API_KEY=

# ---- Canais ----
ISPAGENT_CHANNEL_WHATSAPP_ENABLED=false
ISPAGENT_WHATSAPP_PHONE_NUMBER_ID=
ISPAGENT_WHATSAPP_ACCESS_TOKEN=
ISPAGENT_WHATSAPP_VERIFY_TOKEN=
ISPAGENT_WHATSAPP_APP_SECRET=
# Tenant (provedor) que atende o número do WhatsApp configurado acima.
ISPAGENT_WHATSAPP_TENANT_ID=
# WhatsApp por QR Code via WAHA: o provedor conecta o número na tela "WhatsApp" do painel.
# A chave fica só no servidor. O WAHA Core tem uma sessão, então o número pertence a um tenant.
ISPAGENT_WAHA_URL=
ISPAGENT_WAHA_API_KEY=
ISPAGENT_WAHA_TENANT_ID=
# ISPAGENT_WAHA_SESSION=default
# Mensagens recebidas: o WAHA chama este endereço assinando com HMAC-SHA512 (X-Webhook-Hmac).
# Sem o segredo, nenhum webhook é registrado e o endpoint recusa tudo.
ISPAGENT_WAHA_WEBHOOK_URL=
ISPAGENT_WAHA_WEBHOOK_SECRET=

# ---- Chatwoot (caixa de entrada dos atendentes; o ISPAgent responde como Agent Bot) ----
# URL interna (de dentro do Docker) e pública (para o widget no navegador).
ISPAGENT_CHATWOOT_URL=
ISPAGENT_CHATWOOT_PUBLIC_URL=
ISPAGENT_CHATWOOT_ACCOUNT_ID=
ISPAGENT_CHATWOOT_TENANT_ID=
# Token de acesso do Agent Bot (Configurações → Bots) e segredo do caminho do webhook (>= 32 caracteres):
# o Agent Bot chama <API>/public/chatwoot/webhook/<ISPAGENT_CHATWOOT_WEBHOOK_TOKEN>.
ISPAGENT_CHATWOOT_BOT_TOKEN=
ISPAGENT_CHATWOOT_WEBHOOK_TOKEN=
# Token do widget da caixa "site" (público; só usado pela página /chatwoot-teste).
ISPAGENT_CHATWOOT_WIDGET_TOKEN=

# ---- Atendimento ----
# Conversa com a IA sem mensagem por este tempo é encerrada (com pedido de avaliação); padrão 30.
ISPAGENT_CONVERSATION_IDLE_MINUTES=30
# Aviso automático por WhatsApp de queda coletiva detectada pelo PulseISP (mensagem em massa): opt-in.
ISPAGENT_INCIDENT_AUTO_NOTIFY=false

# ---- Frontend (NEXT_PUBLIC_* são gravadas no bundle no BUILD: mudar exige `docker compose build ispagent-web`) ----
# URL da API vista pelo NAVEGADOR. Vazio = mesmo host da página, porta 3001 (funciona por IP público ou
# domínio sem reconfigurar). Só preencha se a API estiver em outro host/porta.
NEXT_PUBLIC_API_URL=
# Tenant e nome exibidos no Web Chat público.
NEXT_PUBLIC_WEBCHAT_TENANT_ID=tnt_vibe
NEXT_PUBLIC_WEBCHAT_BRAND=Vibe Telecom
# true só em build de demonstração: mostra e pré-preenche as credenciais DEMO na tela de login.
NEXT_PUBLIC_DEMO_MODE=false
# Sites que podem embutir o Web Chat via widget.js (separados por espaço), ex.: https://www.seuprovedor.com.br
ISPAGENT_WEBCHAT_FRAME_ANCESTORS=

# ---- Observabilidade ----
# debug | info | warn | error
ISPAGENT_LOG_LEVEL=info
